# Postgres connection string. Local Supabase runs on this project's dedicated
# port block (55321-55324) rather than the Supabase default (54321-54324), so
# it can run alongside other local Supabase stacks on the same machine.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Voyage AI — https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Optional. The service's public base URL once deployed. When set it becomes the
# primary `servers` entry in /openapi.json, so a generated client targets the
# deployment rather than localhost. Leave unset locally.
# PUBLIC_URL=https://your-service.up.railway.app
